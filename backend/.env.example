# Copy to .env for local work. Never commit a real .env file.
PORT=4000
NODE_ENV=development
# Hosted PostgreSQL connection string (Neon or Render PostgreSQL). Placeholder only.
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
# Long random string. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES=8h
# Comma separated list of allowed browser origins (your Vercel URL and local dev)
FRONTEND_URL=http://localhost:5173
# Set true only for the Electron desktop app (its pages have the "null" origin)
ALLOW_DESKTOP_ORIGIN=false
# One-time browser based first administrator setup. Remove after use.
SETUP_TOKEN=
# Show the SRS style "Invalid User ID" / "Incorrect Password" messages (reveals which IDs exist)
SRS_DETAILED_LOGIN_ERRORS=false
